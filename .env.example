# ── taraonchain environment ─────────────────────────────────────
# Copy the values into Vercel → Settings → Environment Variables.
# See DEPLOY.md for the full walkthrough.

# PostgreSQL connection string.
# On Vercel: created automatically when you add Vercel Postgres
# (Storage → Create Database → connect to this project).
DATABASE_URL=postgresql://user:password@host:5432/taraonchain

# Secret key your publishing agent sends to add/update/remove
# investigations:  x-agent-key: <AGENT_PUBLISH_KEY>
# Generate one:    node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AGENT_PUBLISH_KEY=

# Passcode for the hidden case-template UI (verified server-side).
ADMIN_PASSCODE=taraonchain

# Secret door for the admin UI — the page 404s without it.
# Open:  https://your-domain/admin?door=<ADMIN_DOOR>
ADMIN_DOOR=
